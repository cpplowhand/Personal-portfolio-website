---
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';
import { Copy, Mail } from 'lucide-astro';
---

<section id="contact" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">联系我</h2>
    <p class="mt-3 text-gray-600">无论是工作机会、项目合作，还是单纯想交流技术，都欢迎来信。</p>
  </div>

  <div class="mx-auto mt-10 flex max-w-2xl flex-col items-center gap-4">
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href={`mailto:${site.email}`}
        class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-5 py-3 text-base font-medium text-white transition hover:bg-indigo-700"
      >
        <Mail class="h-5 w-5" /> {site.email}
      </a>
      <button
        type="button"
        id="copy-email"
        class="inline-flex items-center gap-2 rounded-lg border border-gray-300 px-5 py-3 text-base font-medium text-gray-700 transition hover:border-gray-400 hover:bg-gray-50"
      >
        <Copy class="h-5 w-5" />
        <span id="copy-label">复制邮箱</span>
      </button>
    </div>

    <div class="mt-2">
      <SocialLinks />
    </div>
  </div>
</section>

<script define:vars={{ email: site.email }}>
  function initCopy() {
    const btn = document.getElementById('copy-email');
    const label = document.getElementById('copy-label');
    if (!btn || !label) return;

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
        label.textContent = '已复制';
      } catch {
        label.textContent = '复制失败';
      } finally {
        setTimeout(() => (label.textContent = '复制邮箱'), 2000);
      }
    });
  }

  document.addEventListener('astro:page-load', initCopy);
</script>
