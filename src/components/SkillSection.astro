---
import { skillGroups } from '../data/skills';
---

<section id="skills" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">技能</h2>
    <p class="mt-3 text-gray-600">按领域分组，用「熟练 / 熟悉 / 了解」标注程度，而非进度条。</p>
  </div>

  <div class="mt-10 grid gap-6 sm:grid-cols-2">
    {skillGroups.map((group) => (
      <div class="rounded-2xl border border-gray-200 bg-white p-6">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-semibold text-gray-900">{group.category}</h3>
          <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700">
            {group.level}
          </span>
        </div>
        <ul class="mt-4 flex flex-wrap gap-2">
          {group.items.map((item) => (
            <li class="rounded-md bg-gray-100 px-3 py-1.5 text-sm text-gray-700">{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
