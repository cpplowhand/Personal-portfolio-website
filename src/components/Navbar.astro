---
import { site } from '../data/site';
import { Menu, X } from 'lucide-astro';

const nav = [
  { label: '关于', href: '/about' },
  { label: '项目', href: '/projects' },
  { label: '联系', href: '/#contact' },
];
---

<header class="sticky top-0 z-50 border-b border-gray-200/70 bg-white/80 backdrop-blur">
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6"
    aria-label="主导航"
  >
    <a href="/" class="text-lg font-semibold tracking-tight text-gray-900">
      {site.name}
    </a>

    <!-- 桌面导航 -->
    <div class="hidden items-center gap-1 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class="rounded-lg px-4 py-2 text-sm font-medium text-gray-600 transition hover:bg-gray-100 hover:text-gray-900"
        >
          {item.label}
        </a>
      ))}
      <a
        href="/#contact"
        class="ml-2 inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700"
      >
        联系我
      </a>
    </div>

    <!-- 移动端汉堡按钮 -->
    <button
      type="button"
      id="menu-toggle"
      class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-gray-700 transition hover:bg-gray-100 md:hidden"
      aria-label="打开菜单"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span id="menu-open-icon"><Menu class="h-6 w-6" /></span>
      <span id="menu-close-icon" class="hidden"><X class="h-6 w-6" /></span>
    </button>
  </nav>

  <!-- 移动端菜单 -->
  <div id="mobile-menu" class="hidden border-t border-gray-200 bg-white md:hidden">
    <ul class="space-y-1 px-4 py-3">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            class="block rounded-lg px-4 py-3 text-base font-medium text-gray-700 transition hover:bg-gray-100"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  function initMenu() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;

    const openIcon = document.getElementById('menu-open-icon');
    const closeIcon = document.getElementById('menu-close-icon');

    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // 点击菜单项后关闭
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
  }

  document.addEventListener('astro:page-load', initMenu);
</script>
