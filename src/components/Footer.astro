---
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';
import { ArrowUp, Mail } from 'lucide-astro';
---

<footer class="border-t border-gray-200 bg-gray-50">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
      <div class="text-center sm:text-left">
        <p class="text-base font-semibold text-gray-900">{site.name}</p>
        <p class="mt-1 text-sm text-gray-600">
          {site.role} · {site.location}
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href={`mailto:${site.email}`}
          class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-gray-200 text-gray-600 transition hover:border-gray-300 hover:bg-gray-100 hover:text-gray-900"
          aria-label="邮箱"
        >
          <Mail class="h-5 w-5" />
        </a>
        <SocialLinks />
      </div>
    </div>

    <div
      class="mt-8 flex flex-col items-center justify-between gap-4 border-t border-gray-200 pt-6 text-sm text-gray-500 sm:flex-row"
    >
      <p>© {new Date().getFullYear()} {site.name} · 保留所有权利。</p>
      <a
        href="#top"
        class="inline-flex items-center gap-1.5 font-medium text-gray-600 transition hover:text-gray-900"
      >
        返回顶部 <ArrowUp class="h-4 w-4" />
      </a>
    </div>
  </div>
</footer>
