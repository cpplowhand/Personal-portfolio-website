---
import { ArrowRight, ExternalLink } from 'lucide-astro';

interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
  cover?: string;
  link?: string;
}

const { title, description, tags, href, cover, link } = Astro.props;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white transition hover:border-gray-300 hover:shadow-md"
>
  <a href={href} class="flex flex-1 flex-col">
    <div class="relative aspect-video w-full overflow-hidden bg-gray-100">
      {cover ? (
        <img
          src={cover}
          alt={`${title} 封面`}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
        />
      ) : (
        <div
          class="flex h-full w-full items-center justify-center bg-gradient-to-br from-indigo-100 via-white to-gray-100"
        >
          <span class="text-4xl font-bold text-indigo-300">{title.slice(0, 1)}</span>
        </div>
      )}
    </div>

    <div class="flex flex-1 flex-col gap-3 p-5">
      <h3 class="text-lg font-semibold text-gray-900 transition group-hover:text-indigo-600">
        {title}
      </h3>
      <p class="line-clamp-3 flex-1 text-sm leading-relaxed text-gray-600">{description}</p>
      <ul class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li class="rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600">
            {tag}
          </li>
        ))}
      </ul>
    </div>
  </a>

  <div class="flex items-center justify-between border-t border-gray-100 px-5 py-3">
    <a
      href={href}
      class="inline-flex items-center gap-1 text-sm font-medium text-indigo-600 transition hover:text-indigo-700"
    >
      查看案例 <ArrowRight class="h-4 w-4" />
    </a>
    {link && (
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-sm text-gray-500 transition hover:text-gray-900"
        aria-label="访问项目外链"
      >
        <ExternalLink class="h-4 w-4" />
      </a>
    )}
  </div>
</article>
