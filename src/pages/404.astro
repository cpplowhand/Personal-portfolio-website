---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Home } from 'lucide-astro';
---

<BaseLayout title="页面未找到">
  <section class="mx-auto flex max-w-6xl flex-col items-center px-4 py-32 text-center sm:px-6">
    <p class="text-7xl font-bold text-gray-200">404</p>
    <h1 class="mt-4 text-2xl font-semibold text-gray-900">页面未找到</h1>
    <p class="mt-2 text-gray-600">你要找的页面不存在或已被移动。</p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-6 py-3 font-medium text-white transition hover:bg-indigo-700"
    >
      <Home class="h-5 w-5" /> 返回首页
    </a>
  </section>
</BaseLayout>
